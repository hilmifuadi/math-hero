rules_version = '2';
// Aturan Firestore untuk papan skor bersama banyak aplikasi (koleksi "scores"). Tempel di konsol Firebase: Firestore Database > Rules > Publish.
// Siapa pun boleh membaca dan menambah skor yang valid; tidak ada yang boleh mengubah atau menghapus. Semua koleksi lain tertutup.
// Batas: skor dikirim dari browser, jadi orang teknis tetap bisa memalsukan skor atau membanjiri koleksi. Cocok untuk game hobi, bukan kompetisi serius.
service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{id} {
      allow get: if true;
      allow list: if request.query.limit <= 100;
      allow update, delete: if false;
      allow create: if
        request.resource.data.keys().hasOnly(['appId', 'board', 'name', 'score', 'createdAt', 'meta'])
        && request.resource.data.keys().hasAll(['appId', 'board', 'name', 'score', 'createdAt'])
        && request.resource.data.appId is string
        && request.resource.data.appId.matches('^[a-z][a-z0-9-]{1,31}$')
        && request.resource.data.board is string
        && request.resource.data.board.matches('^[a-z0-9_.-]{1,32}$')
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 16
        && request.resource.data.score is int
        && request.resource.data.score >= 0 && request.resource.data.score <= 1000000
        && request.resource.data.createdAt == request.time
        && (!('meta' in request.resource.data)
            || (request.resource.data.meta is map && request.resource.data.meta.size() <= 8));
    }
    // Progres Math Hero 4: satu dokumen per pemain, id = uid acak 16 karakter.
    // Dokumen hanya boleh ditulis ke id-nya sendiri; daftar semua simpanan ditutup.
    match /saves/{uid} {
      allow get: if true;
      allow list: if false;
      allow delete: if false;
      allow create, update: if
        request.resource.data.keys().hasOnly(['uid', 'v', 'nama', 'koin', 'owned', 'equipped', 'best', 'totalStars', 'points', 'stats', 'weapons', 'gear', 'base', 'updatedAt'])
        && request.resource.data.keys().hasAll(['uid', 'v', 'nama', 'koin', 'owned', 'equipped', 'best', 'totalStars', 'points', 'stats', 'weapons', 'gear', 'base', 'updatedAt'])
        && request.resource.data.base is map
        && request.resource.data.points is int
        && request.resource.data.stats is map
        && request.resource.data.weapons is list && request.resource.data.weapons.size() <= 20
        && request.resource.data.gear is map
        && request.resource.data.uid == uid
        && uid.matches('^[a-z0-9]{8,32}$')
        && request.resource.data.v is int
        && request.resource.data.nama is string
        && request.resource.data.nama.size() >= 1 && request.resource.data.nama.size() <= 12
        && request.resource.data.koin is int
        && request.resource.data.koin >= 0 && request.resource.data.koin <= 1000000
        && request.resource.data.totalStars is int
        && request.resource.data.totalStars >= 0 && request.resource.data.totalStars <= 10000
        && request.resource.data.owned is list && request.resource.data.owned.size() <= 40
        && request.resource.data.equipped is map
        && request.resource.data.best is map && request.resource.data.best.size() <= 40
        && request.resource.data.updatedAt is int;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
